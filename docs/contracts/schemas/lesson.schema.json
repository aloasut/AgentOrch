{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentorch.example/schemas/lesson.schema.json",
  "title": "Lesson Record (v1)",
  "description": "跨项目经验教训记录的唯一机器定义。状态转换、证据等级与去重 / 冲突判定见 docs/self-improvement/lesson-lifecycle.md；本文件只冻结字段与可机器判定的约束。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lesson_id",
    "title",
    "content_class",
    "status",
    "evidence_level",
    "source",
    "observation",
    "fingerprint",
    "applicability",
    "suggested_action",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "lesson_id": {
      "type": "string",
      "pattern": "^LSN-[A-Z0-9]{2,12}-[0-9]{3}$",
      "description": "稳定 ID（如 LSN-TALKDND-001）。一旦分配不得复用，也不得因来源停用而删除。"
    },
    "title": { "type": "string", "minLength": 8, "maxLength": 160 },
    "content_class": {
      "enum": [
        "CONFIRMED_FACT",
        "UNVERIFIED_ASSUMPTION",
        "SOURCE_SPECIFIC_EXPERIENCE",
        "GENERAL_LESSON"
      ],
      "description": "四类内容互斥且必属其一：已证实事实 / 待验证假设 / 来源专属经验 / 通用教训。判定与提升规则见 lesson-lifecycle.md §2。"
    },
    "status": {
      "enum": [
        "OBSERVED",
        "NEEDS_VERIFICATION",
        "VERIFIED",
        "REJECTED",
        "GENERALIZED",
        "IMPLEMENTED",
        "REGRESSION_WATCH"
      ],
      "description": "生命周期状态；唯一转换表见 lesson-lifecycle.md §3。"
    },
    "evidence_level": {
      "enum": [
        "E0_CLAIM",
        "E1_SOURCE_ARTIFACT",
        "E2_REPRODUCED",
        "E3_FIXED_WITH_TEST",
        "E4_REGRESSION_COVERED"
      ],
      "description": "证据强度；等级定义见 lesson-lifecycle.md §2.2。UNVERIFIED_ASSUMPTION 最高只能到 E1。"
    },
    "source": { "$ref": "#/$defs/source_ref" },
    "observation": { "$ref": "#/$defs/observation" },
    "fingerprint": { "$ref": "#/$defs/fingerprint" },
    "duplicate_of": {
      "description": "指向已存在的等价教训；非 null 时本条不得再生成新的改进任务。",
      "anyOf": [
        { "type": "string", "pattern": "^LSN-[A-Z0-9]{2,12}-[0-9]{3}$" },
        { "type": "null" }
      ]
    },
    "conflicts_with": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/conflict" },
      "description": "与本条证据或适用条件冲突的其它教训；OPEN 冲突禁止单方面采纳，见 lesson-lifecycle.md §5。"
    },
    "applicability": { "$ref": "#/$defs/applicability" },
    "suggested_action": { "$ref": "#/$defs/suggested_action" },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issues": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "pull_requests": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "modules": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "decision": {
      "description": "人工或架构决策记录；REJECTED / GENERALIZED / IMPLEMENTED 必填。",
      "anyOf": [
        { "$ref": "#/$defs/decision" },
        { "type": "null" }
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "evidence_kind", "evidence_urls", "observed_at", "captured_at"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
        "evidence_kind": { "enum": ["pull_request", "issue", "review", "commit", "ci_run", "documentation"] },
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" },
          "description": "可定位的来源链接；不得内联私有数据或凭据。"
        },
        "observed_at": { "type": "string", "format": "date-time" },
        "captured_at": { "type": "string", "format": "date-time" },
        "source_commit": {
          "description": "来源提交 SHA（可定位时填写，否则 null）。",
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_fact", "repro_conditions", "root_cause", "impact", "why_missed"],
      "properties": {
        "observed_fact": { "type": "string", "minLength": 16, "maxLength": 2000 },
        "repro_conditions": {
          "type": "string",
          "minLength": 8,
          "maxLength": 2000,
          "description": "最小复现条件或源码级证据说明；无法复现时写 \"not reproducible: <原因>\"。"
        },
        "root_cause": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "impact": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "why_missed": {
          "type": "string",
          "minLength": 8,
          "maxLength": 2000,
          "description": "原流程 / 测试为何未发现；这是判断是否值得改 AgentOrch 的依据。"
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value", "normalized_fields"],
      "description": "去重指纹。算法与规范化字段只由 lesson-lifecycle.md §4 定义。",
      "properties": {
        "algorithm": { "const": "sha256-normalized-v1" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "normalized_fields": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["root_cause", "impact", "affected_surface", "suggested_action_target"] }
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "applies_to", "excluded_contexts"],
      "properties": {
        "scope": {
          "enum": ["source_only", "agentorch_general"],
          "description": "source_only 表示不得提升为核心规则；agentorch_general 才可映射为 AgentOrch 改进对象。"
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "适用模块、契约或流程标识。"
        },
        "excluded_contexts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "suggested_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "summary", "cost", "risk"],
      "properties": {
        "target": { "enum": ["CONTRACT", "CODE", "TEST", "DOCUMENTATION", "PROCESS", "METRIC"] },
        "summary": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "cost": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "risk": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "validation_command": {
          "type": ["string", "null"],
          "description": "建议的验证命令；未实测时写 null，不得写成已验证。"
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_id", "conflict_type", "resolution"],
      "properties": {
        "lesson_id": { "type": "string", "pattern": "^LSN-[A-Z0-9]{2,12}-[0-9]{3}$" },
        "conflict_type": { "enum": ["CONTRADICTS", "SUPERSEDES", "OVERLAPS"] },
        "resolution": { "enum": ["OPEN", "RESOLVED_BY_EVIDENCE", "RESOLVED_BY_OWNER"] },
        "resolution_evidence": {
          "type": ["string", "null"],
          "maxLength": 1000,
          "description": "非 OPEN 时必须给出可定位证据（链接、Issue / PR 编号或决策 ID）。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "resolution": { "enum": ["RESOLVED_BY_EVIDENCE", "RESOLVED_BY_OWNER"] } },
            "required": ["resolution"]
          },
          "then": {
            "required": ["resolution_evidence"],
            "properties": { "resolution_evidence": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decided_by", "decided_at", "outcome", "rationale"],
      "properties": {
        "decided_by": {
          "type": "string",
          "minLength": 1,
          "description": "具体决策人 / 角色；不得写 \"team\"。"
        },
        "decided_at": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["ADOPT", "DEFER", "REJECT"] },
        "rationale": { "type": "string", "minLength": 8, "maxLength": 2000 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "content_class": { "const": "UNVERIFIED_ASSUMPTION" } },
        "required": ["content_class"]
      },
      "then": {
        "properties": { "evidence_level": { "enum": ["E0_CLAIM", "E1_SOURCE_ARTIFACT"] } }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["VERIFIED", "GENERALIZED", "IMPLEMENTED", "REGRESSION_WATCH"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "content_class": { "enum": ["CONFIRMED_FACT", "SOURCE_SPECIFIC_EXPERIENCE", "GENERAL_LESSON"] },
          "evidence_level": { "enum": ["E2_REPRODUCED", "E3_FIXED_WITH_TEST", "E4_REGRESSION_COVERED"] }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["GENERALIZED", "IMPLEMENTED"] } },
        "required": ["status"]
      },
      "then": {
        "required": ["decision"],
        "properties": {
          "content_class": { "const": "GENERAL_LESSON" },
          "decision": { "$ref": "#/$defs/decision" },
          "conflicts_with": {
            "type": "array",
            "not": {
              "contains": {
                "properties": { "resolution": { "const": "OPEN" } },
                "required": ["resolution"]
              }
            }
          },
          "applicability": {
            "type": "object",
            "required": ["scope"],
            "properties": { "scope": { "const": "agentorch_general" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "REJECTED" } },
        "required": ["status"]
      },
      "then": {
        "required": ["decision"],
        "properties": { "decision": { "$ref": "#/$defs/decision" } }
      }
    },
    {
      "if": {
        "properties": { "content_class": { "const": "GENERAL_LESSON" } },
        "required": ["content_class"]
      },
      "then": {
        "properties": {
          "status": { "enum": ["VERIFIED", "GENERALIZED", "IMPLEMENTED", "REJECTED", "REGRESSION_WATCH"] }
        }
      }
    },
    {
      "if": {
        "properties": { "content_class": { "const": "SOURCE_SPECIFIC_EXPERIENCE" } },
        "required": ["content_class"]
      },
      "then": {
        "properties": {
          "applicability": {
            "type": "object",
            "required": ["scope"],
            "properties": { "scope": { "const": "source_only" } }
          }
        }
      }
    }
  ]
}
